rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Configuración global del temporizador / cuenta atrás de Pokémon
    match /config/countdown {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Historial de tiradas de la ruleta sincronizadas
    match /roulette_spins/{spinId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Apuestas y tiradas del Casino de 27 números
    match /casino_bets/{betId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Canjes oficiales de la tienda (Shinies y Respuestas de Carlos) para verificación
    match /casino_redemptions/{redemptionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Perfil de usuario: lectura y actualización básica si está logueado
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      // Partidas guardadas: cada usuario guarda y carga sus propias partidas
      match /saves/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Regla de respaldo durante desarrollo
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
