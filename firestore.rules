rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil de usuario: lectura y actualización básica si está logueado
    match /users/{userId} {
      allow read, write: if request.auth != null;
      
      // Partidas guardadas: cada usuario guarda y carga sus propias partidas
      match /saves/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Regla de respaldo durante desarrollo
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
